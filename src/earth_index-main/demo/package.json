{
  "name": "earth-index-demo",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run check && vite build",
    "test": "node --import tsx --test tests/*.test.ts && vitest run",
    "generate": "mkdir -p src/gen && protoc -I ../backend/proto --plugin=protoc-gen-es=./node_modules/.bin/protoc-gen-es --es_out=src/gen --es_opt=target=ts ../backend/proto/earth_index.proto",
    "check": "svelte-check --tsconfig tsconfig.json --fail-on-warnings",
    "evaluate": "tsx scripts/evaluate-matching.ts",
    "navigation-preview": "tsx scripts/navigation-preview.ts",
    "verify-deployment": "tsx scripts/verify-deployment.ts",
    "format": "prettier --write "
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.17.0",
    "@connectrpc/connect": "2.3.0",
    "@connectrpc/connect-web": "2.3.0",
    "ol": "10.11.0",
    "proj4": "^2.23.0",
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "2.17.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "24.19.2",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.8",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
