# Generate private local values with: python3 scripts/setup_local_env.py
POSTGRES_PORT=5432
API_PORT=8080
GRPCUI_PORT=8081
POSTGRES_PASSWORD=replace_with_generated_password
API_DB_PASSWORD=replace_with_generated_password
# setup_local_env.py also writes DATABASE_URL and API_DATABASE_URL for host clients.

# Embedded DuckDB serving; PostgreSQL settings above are for legacy ingestion.
DUCKDB_PATH=./db/runtime/earth.duckdb
DUCKDB_THREADS=8
DUCKDB_MEMORY_LIMIT=8GB
